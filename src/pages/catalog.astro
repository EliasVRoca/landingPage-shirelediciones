        <div
            class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row md:max-w-3xl hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700 mx-8 mb-4"
        >
            <img
                class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-48 md:rounded-none md:rounded-s-lg"
                src="/pa1.jpg"
                alt=""
            />
            <div class="flex flex-col justify-between p-4 leading-normal">
                <h5
                    class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
                >
                    Mi Texto de Música Pre-Kinder
                </h5>
                <p class="mb-1 font-normal text-gray-700 dark:text-gray-400">
                    <strong> Autoría y Producción general: </strong> Janeth Aracena
                    de Zenteno, Sandro Jesús Alcon Ibarra.
                </p>
                <p class="mb-3 font-normal text-gray-700 dark:text-gray-400">
                    <strong>Editorial: </strong> Ediciones SHIREL.
                </p>
                <p class="mb-1 font-normal text-gray-700 dark:text-gray-400">
                    <strong>Precio: </strong> 75Bs.
